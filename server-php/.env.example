PUBLIC_BASE_URL=https://uat-people.sbmgroup.mu

# Paths are relative to api/ when this file is copied to api/.env.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Example: credentials/google-service-account.json

APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_WWDR_CERT_PEM=
APPLE_PASS_KEY_PASSWORD=

# Relative to api/, not to the frontend dist/ directory.
PROFILES_FILE=private/profiles.enc.json
PROFILES_KEY_FILE=private/profiles.key

# Optional Windows/IIS key-generation configuration: use the actual installed path.
# OPENSSL_CONF=C:/PHP/extras/ssl/openssl.cnf
