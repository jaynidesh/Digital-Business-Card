<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- PHP's FastCGI handler is configured in IIS, using the installed php-cgi.exe. -->
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <clear />
        <rule name="Wallet PHP front controller" stopProcessing="true">
          <match url="^(?!index\.php$).*" />
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
