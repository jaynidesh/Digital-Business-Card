flowchart LR
    visitor[Customer browser] --> static[Static host / Angular app]
    staff[Staff browser] --> static

    subgraph browser[Angular SPA in browser]
        router[Router and AppComponent]
        examples[Examples page]
        staffPage[Staff card page]
        publicPage[Public contact page]
        profiles[PublicProfileService]
        mock[(Bundled MOCK_PROFILES)]
        qr[qrcode library]
        webapis[Share / clipboard / vCard browser APIs]
        sw[Angular service worker]
    end

    static --> router
    static --> sw
    router -->|/| examples
    router -->|/staff/staff-token| staffPage
    router -->|/contact/public-token| publicPage
    examples --> mock
    staffPage -->|getByStaffToken| profiles
    publicPage -->|getByToken| profiles
    profiles --> mock
    staffPage --> qr
    publicPage --> qr
    staffPage --> webapis
    publicPage --> webapis
    staffPage -.->|public token link| publicPage
    staffPage -->|/api wallet request| walletRoute[Wallet endpoint]
    publicPage -->|/api wallet request| walletRoute
    walletRoute -->|Node option| nodeWallet[Node Wallet service]
    walletRoute -->|PHP option| phpWallet[PHP Wallet service]
    nodeWallet --> data[(Shared demo profiles)]
    phpWallet --> data
    nodeWallet --> keys[(Signing credentials)]
    phpWallet --> keys
    nodeWallet -->|signed pkpass| apple[Apple Wallet]
    phpWallet -->|signed pkpass| apple
    nodeWallet -->|OAuth and class/object sync| googleApi[Google Wallet Objects API]
    phpWallet -->|OAuth and class/object sync| googleApi
    nodeWallet -->|signed ID-only save JWT| google[Google Wallet]
    phpWallet -->|signed ID-only save JWT| google
