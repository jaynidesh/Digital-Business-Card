flowchart LR
    visitor[Customer browser] --> static[Static host / Angular app]
    staff[Staff browser] --> static

    subgraph browser[Angular SPA in browser]
        router[Router and AppComponent]
        examples[Examples page]
        staffPage[Staff card page]
        publicPage[Public contact page]
        profiles[PublicProfileService]
        mock[(Bundled MOCK_PROFILES)]
        qr[qrcode library]
        webapis[Share / clipboard / vCard browser APIs]
        sw[Angular service worker]
    end

    static --> router
    static --> sw
    router -->|/| examples
    router -->|/staff/staff-token| staffPage
    router -->|/contact/public-token| publicPage
    examples --> mock
    staffPage -->|getByStaffToken| profiles
    publicPage -->|getByToken| profiles
    profiles --> mock
    staffPage --> qr
    publicPage --> qr
    staffPage --> webapis
    publicPage --> webapis
    staffPage -.->|public token link| publicPage
    staffPage -->|/api wallet request| wallet
    publicPage -->|/api wallet request| wallet[Node Wallet service]
    wallet --> data[(Shared demo profiles)]
    wallet --> keys[(Signing credentials)]
    wallet -->|signed pkpass| apple[Apple Wallet]
    wallet -->|OAuth and class/object sync| googleApi[Google Wallet Objects API]
    wallet -->|signed ID-only save JWT| google[Google Wallet]
